# AI Project Harness — Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# agentmemory configuration (optional)
# AGENTMEMORY_URL=http://localhost:3111
# AGENTMEMORY_SECRET=
# AGENTMEMORY_PROJECT_NAME=MyProject

# LLM provider keys (required for agentmemory, not for core harness)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Embedding provider (optional, defaults to local)
# EMBEDDING_PROVIDER=local
